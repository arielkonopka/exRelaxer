@startuml sequence_step
skinparam shadowing false
skinparam sequenceMessageAlign left
autonumber

title One tick: setInputs, step, outputs, applyReward

actor Caller
participant network
participant "layer (dense)" as L
participant "Group" as G
participant "weight_matrix" as W
participant neuron

Caller -> network : setInputs(values)
note right : copies the values into the\nnetwork-owned sensor buffer

Caller -> network : step()
network -> network : updateOrder()
note right
  default: topological order of connect
  edges (cached until the graph changes);
  or the custom order
end note

loop each layer in update order
  network -> L : forward()
  loop each group, in creation order
    L -> G : gather()
    note right
      memcpy each input range into values[]:
      reads source outputs as they are NOW
      (already updated this tick or not)
    end note
    L -> W : multiply(values, sums)\n8 neurons per SIMD pass,\nthreads by work (OpenMP)
    L -> neuron : activate(sums[i])
    neuron -> neuron : clamp +-10,\nhabituation, E-R
    neuron --> L : output, written to the layer's output buffer
  end
end

Caller -> network : outputs()
network --> Caller : output layers' values

Caller -> network : applyReward(reward, rate)
loop each layer that is not frozen
  network -> L : applyReward(reward, rate)
  loop each group
    L -> G : gather(), then sign of each input
    L -> neuron : eligible()? learningDelta(reward, rate)
    L -> W : learn(signs, deltas, eligible)
    note right
      eligible rows:
      w += delta x sign(x), clamp +-10
      (same thread split as forward)
    end note
  end
end

@enduml
