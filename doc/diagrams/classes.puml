@startuml classes
skinparam shadowing false
skinparam classAttributeIconSize 0
hide empty members

title exrelaxer - class diagram (public API)

enum LayerType {
  Dense = 0
  Conv2D = 1
  Pool2D = 2
  LocallyConnected2D = 3
  Retina = 4
}

enum DeserializeMode {
  WeightsOnly
  FullState
}

class LayerSpec <<struct>> {
  +type : LayerType = Dense
  +size : size_t = 0
  +hasHabituation : bool = true
  +hasER : bool = true
  +frozen : bool = false
  +recoveryJitter : Jitter
  +learningJitter : Jitter
  +alphaJitter : Jitter
  +window : Window2D
  +pool : PoolMode
  +retina : RetinaSpec
  +{static} Dense / Conv2D / LocallyConnected2D / Pool2D / Retina(...)
}

class Jitter <<struct>> {
  +distribution : None | Uniform | Normal
  +spread : float
  +relative : bool
  +mean : optional<float>
  +min, max : float
  +enabled() : bool
  +{static} none() / uniform(halfWidth) / normal(sd)
  +{static} uniformRelative(f = 0.5) / normalRelative(f = 0.5)
  +around(centre) / within(lo, hi) : Jitter
}

class neuron {
  +neuron(hasHabituation = true, hasER = true, alpha = default_alpha)
  --
  +activate(weightedSum : float) : float
  +output() : float / setOutput(value)
  +eligible() : bool
  +learningDelta(reward, learningRate) : float
  +step(inputs, weights) : float
  +learn(weights, inputs, reward, learningRate)
  --
  +randomizeRecovery(jitter) / randomizeLearningGain(jitter)
  +randomizeAlpha(jitter)
  +randomizeDynamics(recovery, learning, alpha)
  +recovery() / learningGain() / alpha() and setters
  --
  +serialize(os, weights)
  +deserialize(is, mode, format) : vector<float>
  --
  -threshold_ : float
  -previous_input_ : float
  -habituation_counter_ : int
  -output_ : float
  -alpha_, recovery_, learning_gain_ : float
  -rng_ : minstd_rand
}

class Shape <<struct>> {
  +channels, height, width : size_t
  +size() : size_t
}

class InputRange <<struct>> {
  +buffer : reference_wrapper<const vector<float>>
  +offset, count : size_t
}

abstract class layer {
  +{abstract} type() : LayerType
  +shape() : Shape
  +size() : size_t
  +output() : span<const float>
  +outputBuffer() : const vector<float>&
  --
  +{abstract} forward()
  +applyReward(reward, learningRate)
  +join(source : layer&)
  +attachInputs(sensors : InputRange)
  +addNeurons(count, source : layer&)
  +addFeedback(target : layer&, count)
  +hasReaders() : bool
  +{abstract} serialize(os)
  +{abstract} deserialize(is, mode, neuronFormat)
  --
  #output_ : vector<float>
  #readFrom(source : layer&)
  #outputGrew(oldSize)
  #sourceGrew(source, offset, count)
  -readers_, sources_ : vector<reference_wrapper<layer>>
}

abstract class neuron_layer {
  +neurons() : span<neuron>
  +setOutput(index, value)
  +setRecoveryJitter / setLearningJitter / setAlphaJitter(jitter)
  +serialize(os) / deserialize(is, mode, neuronFormat)
  --
  #newNeuron() : neuron&
  #{abstract} copyWeights / expectedWeights / storeWeights
  #{abstract} wired() : bool
  #neurons_ : vector<neuron>
}

class dense {
  +dense(count = 0, hasHabituation = true, hasER = true,\n    recoveryJitter = {}, learningJitter = {}, alphaJitter = {})
  +weights(i) : vector<float>
  +setWeights(i, weights)
  +inputCount(i) : size_t
  +groupCount() / groupNeurons(g) / groupOf(i)
  --
  -groups_ : vector<Group>
  -group_of_ : vector<size_t>
  -addGroup(group)
}

abstract class spatial_neuron_layer {
  +shape() : Shape
  +window() : Window2D
  +outputChannels() / inputChannels() / windowSize()
  +join(source)
  --
  #{abstract} createWeights() / appendInputs(count)
  -inputs_ : spatial_inputs
}

class conv2d {
  +conv2d(channels, window, ...)
  +kernel(c) / setKernel(c, weights)
  -kernels_ : vector<float>
}

class locally_connected2d {
  +locally_connected2d(channels, window, ...)
  +weights(i) / setWeights(i, weights)
  -weights_ : vector<weight_matrix>
}

class retina {
  +retina(RetinaSpec, ...)
  +samples() / samplePoint(k)
  +attachInputs(sensors)
}

class pool2d {
  +pool2d(window, mode)
  +shape() : Shape
}

class Window2D <<struct>> {
  +kernelHeight, kernelWidth
  +strideY, strideX, padY, padX
  +{static} square(kernel, stride, padding)
}

class RetinaSpec <<struct>> {
  +input : Shape
  +sampling : Grid | Spiral
  +spacing, radius : float
}

class "dense::Group" as Group <<struct>> {
  +inputs : vector<InputRange>
  +sources : vector<reference_wrapper<const layer>>
  +neurons : {first, count}
  +weights : kernels::weight_matrix
}

class "kernels::weight_matrix" as weight_matrix {
  +{static} lanes = 8
  +multiply(x, sums, firstBlock, lastBlock)
  +learn(signs, delta, active, limit, firstBlock, lastBlock)
  +appendColumns(count, rowMajor)
  +copyRow(r, out) / setRow(r, values)
  -data_ : aligned vector<float>
}

class layer_factory {
  +layer_factory()
  +{static} instance() : layer_factory&
  +registerType(type : LayerType, creator : Creator)
  +isRegistered(type : LayerType) : bool
  +create(spec : LayerSpec) : unique_ptr<layer>
}

class network {
  +network(factory = layer_factory::instance())
  .. building ..
  +addLayer(name, spec : LayerSpec) : LayerId
  +connect(from, to)
  +addFeedback(from, to, width)
  +addInputs(target, count) : size_t
  +addOutput(id)
  +freeze(id) / unfreeze(id) / isFrozen(id)
  +setRecoveryJitter(id, jitter) / setLearningJitter(id, jitter)
  +setAlphaJitter(id, jitter)
  +setUpdateOrder(order) / useDefaultUpdateOrder()
  .. running ..
  +setInput(index, value) / setInputs(values)
  +step()
  +applyReward(reward, learningRate)
  +outputs() : vector<float>
  .. inspection ..
  +layerCount() / getLayer(id) / findLayer(name)
  +layerName(id) / layerSpec(id)
  +edges() / outputLayers() / inputCount() / inputs() : span<const float>
  +updateOrder() : vector<LayerId>
  +describe(os)
  .. serialization ..
  +save(os)
  +{static} load(is, mode, factory) : unique_ptr<network>
}

enum "network::EdgeKind" as EdgeKind {
  Forward
  Feedback
}

class "network::Edge" as Edge <<struct>> {
  +from : LayerId
  +to : LayerId
  +kind : EdgeKind
  +width : size_t
}

layer <|-- neuron_layer
neuron_layer <|-- dense
neuron_layer <|-- spatial_neuron_layer
spatial_neuron_layer <|-- conv2d
spatial_neuron_layer <|-- locally_connected2d
neuron_layer <|-- retina
layer <|-- pool2d
spatial_neuron_layer --> Window2D
pool2d --> Window2D
retina --> RetinaSpec
LayerSpec *-- Window2D
LayerSpec *-- RetinaSpec
neuron_layer *-- "0..*" neuron
dense *-- "0..*" Group
Group *-- weight_matrix
Group o-- "0..*" InputRange
layer --> LayerType
layer ..> Shape
layer ..> DeserializeMode
neuron ..> DeserializeMode
layer_factory ..> LayerSpec
layer_factory ..> layer : creates
LayerSpec --> LayerType
LayerSpec *-- "3" Jitter
neuron ..> Jitter
network --> layer_factory
network *-- "0..*" layer
network *-- "0..*" Edge
network ..> LayerSpec
Edge --> EdgeKind

@enduml
