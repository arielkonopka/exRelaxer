@startuml composition
' Ownership and references between the objects of a running network.
' Filled diamond = owns (lifetime bound), open diamond / dashed = refers to.
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
hide empty methods
hide circle

title exrelaxer - object composition

class network {
  nodes : vector<Node>
  edges_ : vector<Edge>
  ops_ : vector<BuildOp>
  inputs_ : vector<float>
  outputs_ : vector<LayerId>
  order_ : vector<LayerId>
}

class "network::Node" as Node {
  name : string
  spec : LayerSpec
  impl : unique_ptr<layer>
}

class "network::Edge" as Edge {
  from, to : LayerId
  kind : EdgeKind
  width : size_t
}

class "network::BuildOp" as BuildOp {
  kind : OpKind
  a, b, count : size_t
}

class layer_factory {
  creators : map<LayerType, Creator>
}

class LayerSpec {
  type, size
  hasHabituation, hasER
  frozen
  recoveryJitter, learningJitter, alphaJitter
}

abstract class layer {
  output_ : vector<float>
  readers_, sources_ : vector<reference_wrapper<layer>>
}

abstract class neuron_layer {
  neurons_ : vector<neuron>
  jitter settings
}

class dense {
  groups_ : vector<Group>
  group_of_ : vector<size_t>
}

class "dense::Group" as Group {
  inputs : vector<InputRange>
  sources : vector<reference_wrapper<const layer>>
  neurons : {first, count}
  weights : weight_matrix
  values : vector<float>
}

class "kernels::weight_matrix" as weight_matrix {
  data_ : blocks of 8 rows,\nlanes adjacent per input
}

class neuron {
  threshold, previous_input
  habituation_counter, output
  rng : minstd_rand
  recovery, learning_gain, alpha
}

class "InputRange" as Range {
  buffer : reference_wrapper<const vector<float>>
  offset, count
}

network *-- "0..*" Node
network *-- "0..*" Edge
network *-- "0..*" BuildOp : construction history\n(replayed by load)
network o.. layer_factory : const& (must outlive)
Node *-- LayerSpec
Node *-- "1" layer : unique_ptr

layer <|-- neuron_layer
neuron_layer <|-- dense
layer o.. "0..*" layer : readers\n(told when my output grows)

neuron_layer *-- "0..*" neuron
dense *-- "0..*" Group
Group *-- "1" weight_matrix
Group *-- "0..*" Range
Range o.. layer : another layer's output_
Range o.. network : sensors: inputs_\n(attachInputs)

layer_factory ..> layer : creates
layer_factory ..> LayerSpec : reads

@enduml
